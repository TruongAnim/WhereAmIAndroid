<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Debug builds may point at a local ingest emulator over plain HTTP.
      Android blocks cleartext by default, which otherwise shows up only as
      "Cleartext HTTP traffic not permitted" inside the upload log.

      Debug source set only: release builds keep the platform default and can
      talk to HTTPS endpoints alone.
    -->
    <application
        android:usesCleartextTraffic="true"
        tools:ignore="UnusedAttribute" />

</manifest>
